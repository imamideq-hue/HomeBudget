# Google OAuth client IDs (optional) — enables "Sign in with Google" in Settings.
# Create them at https://console.cloud.google.com → APIs & Services → Credentials.
# Copy this file to `.env` and fill in the values, then rebuild.

# Web client ID (also used by Expo Go via the auth proxy).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android client ID (Android package: com.imamideq.homebudget).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS client ID (bundle id: com.imamideq.homebudget).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
